# App
MARKET_SENTINEL_ENV=local
MARKET_SENTINEL_DB_URL=sqlite:///./data/market_sentinel.sqlite3

# OpenAI / GPT-6 Astra reasoning layer. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
ASTRA_MAX_CONTEXT_REQUESTS_PER_DAY=25
ASTRA_MIN_SIGNAL_CONFIDENCE=0.72
ASTRA_MAX_INPUT_TOKENS_PER_REQUEST=4000
ASTRA_MAX_OUTPUT_TOKENS_PER_REQUEST=800
ASTRA_MAX_DAILY_COST_USD=2.0
ASTRA_INPUT_COST_PER_MILLION=10.0
ASTRA_OUTPUT_COST_PER_MILLION=50.0
ASTRA_USAGE_PATH=logs/astra-usage.jsonl

# Market data adapters. Keep providers replaceable behind interfaces.
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
MARKET_DATA_POLL_SECONDS=60

# Provider-backed instrument search. Yahoo is public and replaceable behind an adapter.
INSTRUMENT_SEARCH_PROVIDER=yahoo
INSTRUMENT_SEARCH_BASE_URL=https://query1.finance.yahoo.com/v1/finance/search

# Order book. Binance public depth needs no API key; demo is the default.
MARKET_ORDER_BOOK_PROVIDER=demo
MARKET_ORDER_BOOK_BASE_URL=
MARKET_ORDER_BOOK_DEPTH=20
MARKET_ORDER_BOOK_POLL_SECONDS=10

# Alerts. R0 ships in dry-run mode only.
ALERTS_DRY_RUN=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# Risk defaults for simulated and alert-only releases.
RISK_MAX_POSITION_PCT=0.02
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_DEFAULT_FEE_BPS=1.0
RISK_DEFAULT_SLIPPAGE_BPS=2.0
RISK_DEFAULT_SPREAD_BPS=1.0
